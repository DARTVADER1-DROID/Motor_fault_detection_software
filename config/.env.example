# Motor Control System v3.0 — Environment Configuration
# Copy this file to .env in the project root before running.
# For Railway: Set these in Railway dashboard → Variables section

# ── Server ───────────────────────────────────────────────────────
# Railway automatically provides $PORT, but you can override:
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WORKERS=4
DEBUG=false

# ── Database (optional) ──────────────────────────────────────────
# Leave commented out to run in cache-only mode (fully functional).
# For Railway: Provision a PostgreSQL database and Railway will provide DATABASE_URL automatically
# Uncomment and set a real PostgreSQL URL for sensor/fault/command persistence.
# DATABASE_URL=postgresql://user:password@host:5432/motor_db

# ── Railway Deployment ───────────────────────────────────────────
# These are set automatically by Railway, but document them here:
# RAILWAY_ENVIRONMENT_NAME=production
# RAILWAY_PROJECT_NAME=motor-fleet-system
# PORT={automatically set by Railway}

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
